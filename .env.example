# ─────────────────────────────────────────────────────────────────────────────
# Restaurant AI Voice Agent — environment variables template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Restaurant AI Voice Agent"
APP_ENV=development          # development | staging | production
DEBUG=true
# LOG_FILE=logs/server.log     # also keep the app log in a file (rotated; survives restarts)

# ── Database ──────────────────────────────────────────────────────────────────
# Psycopg 3 connection string.  Replace <password> with the real password.
# Special characters in the password must be percent-encoded
# (e.g. p@ss → p%40ss).  See: https://docs.sqlalchemy.org/en/20/core/engines.html
DATABASE_URL=postgresql+psycopg://restaurant_app:<password>@localhost:5432/restaurant_ai

# Optional pool tuning (sensible defaults are built in):
# DB_POOL_SIZE=5
# DB_POOL_MAX_OVERFLOW=10
# DB_CONNECT_TIMEOUT=5
# DB_ECHO_SQL=false

# ── LLM provider (ordering agent) ─────────────────────────────────────────────
# Any OpenAI-compatible chat-completions API.  The model MUST support
# tool/function calling.  Without LLM_API_KEY and LLM_MODEL the agent endpoint
# returns 503; everything else keeps working.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=<your-api-key>
# LLM_MODEL=<model-with-tool-calling>
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_TOKENS=500
# LLM_TEMPERATURE=            # leave unset if the model rejects custom values

# Agent limits (sensible defaults are built in):
# AGENT_MAX_MODEL_CALLS=4
# AGENT_MAX_TOOL_CALLS=6
# AGENT_SESSION_TTL_SECONDS=1800
# AGENT_MAX_SESSIONS=1000

# ── Staff access and customer order tokens ────────────────────────────────────
# Staff endpoints (menu/stock changes, order administration, DEMO payment
# simulation) need header X-Staff-Key with this value; unset, they answer 503.
# STAFF_API_KEY=<long-random-string>
# HMAC secret for customer order tokens (X-Order-Token). Unset: tokens are
# per-process and stop working after a restart.
# ORDER_TOKEN_SECRET=<long-random-string>
# Dashboard (http://127.0.0.1:8000/dashboard; sign in with STAFF_API_KEY):
# DASHBOARD_SESSION_HOURS=12
# DASHBOARD_LOW_STOCK_THRESHOLD=5
# DASHBOARD_EVENTS_SECONDS=3

# ── Orders: stock reservations (DEMO PAYMENT MODE: no real money) ─────────────
# ORDER_RESERVATION_TTL_SECONDS=600   # unpaid orders hold their stock this long
# RESERVATION_SWEEP_SECONDS=60        # background expiry sweep (0 = off)
# LLM_RATE_LIMIT_MAX_WAIT_SECONDS=15  # on HTTP 429, wait this long at most and retry once
# LLM_REASONING_EFFORT=low            # reasoning models (Groq gpt-oss): low | medium | high

# ── Telephony: Exotel Voicebot applet ─────────────────────────────────────────
# Point the Voicebot applet in your Exotel call flow at
#   wss://<EXOTEL_WS_USERNAME>:<EXOTEL_WS_PASSWORD>@<public-host>/telephony/exotel/voicebot
# (optionally ?restaurant_id=<uuid> to override EXOTEL_RESTAURANT_ID).
# EXOTEL_RESTAURANT_ID=<restaurant-uuid>
# EXOTEL_WS_USERNAME=<choose-a-username>
# EXOTEL_WS_PASSWORD=<choose-a-long-random-password>
# EXOTEL_SAMPLE_RATE=8000      # must match the applet's sample-rate (8000 default)
# EXOTEL_GREETING=             # default: "Welcome to <restaurant>. ..."
# EXOTEL_CHUNK_BYTES=3200      # outbound audio chunk (200 ms); smaller = faster barge-in
# VOICE_FILLER_AFTER_MS=2000   # say a cached "One moment." if a reply takes longer (0 = off)
# VOICE_STILL_WORKING_AFTER_MS=9000  # then a cached "still working" phrase (0 = off)
# VOICE_PHRASE_CACHE_DIR=.cache/voice_phrases  # keep greeting/apology audio on disk (recommended)
# VOICE_TURN_TIMEOUT_SECONDS=30   # a turn that takes longer gets a spoken apology
# VOICE_START_TIMEOUT_SECONDS=10  # close sockets that never send "start"
# VOICE_IDLE_TIMEOUT_SECONDS=20   # close calls whose audio stream stops
# SPEECH_TIMEOUT_SECONDS=8        # per speech-to-text / text-to-speech request
# SPEECH_RATE_LIMIT_MAX_WAIT_SECONDS=3  # on HTTP 429, wait this long at most and retry once

# ── Speech (OpenAI-compatible /audio/transcriptions and /audio/speech) ────────
# Phone calls are rejected until SPEECH_API_KEY, STT_MODEL and TTS_MODEL are set.
# MVP setup: Groq for LLM, STT and TTS with ONE Groq key (same value as
# LLM_API_KEY above, with LLM_BASE_URL=https://api.groq.com/openai/v1 and
# LLM_MODEL=llama-3.3-70b-versatile).
# Groq TTS (Orpheus) is English-only and in preview; see README.
# SPEECH_PROVIDER=groq         # groq | openai
# SPEECH_BASE_URL=https://api.groq.com/openai/v1
# SPEECH_API_KEY=<your-groq-api-key>
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=en
# TTS_MODEL=canopylabs/orpheus-v1-english
# TTS_VOICE=troy
#
# OpenAI instead: SPEECH_PROVIDER=openai, SPEECH_BASE_URL=https://api.openai.com/v1,
# STT_MODEL=whisper-1, TTS_MODEL=tts-1, TTS_VOICE=alloy, TTS_SAMPLE_RATE=24000.

# Voice activity detection (when the caller has finished speaking):
# VAD_ENERGY_THRESHOLD=450
# VAD_SILENCE_MS=700
# VAD_MIN_SPEECH_MS=200
# VAD_MAX_UTTERANCE_MS=15000

# ── WhatsApp Business Platform (Task 6) ───────────────────────────────────────
# WHATSAPP_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
